# DeepGIS-XR Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Django Settings
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=deepgis.org,localhost,127.0.0.1,192.168.0.186

# Twilio Configuration (for phone number authentication)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Redis Configuration (for Celery)
REDIS_URL=redis://redis:6379/0

# GIS Services Configuration
VECTOR_TILES_URL=https://vector_tiles:8080
RASTER_TILES_URL=https://raster_tiles:8081
