# DeepGIS-XR Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Django Settings
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=deepgis.org,localhost,127.0.0.1,192.168.0.186

# Database
# Leave DATABASE_URL unset to keep the legacy SQLite path
# (settings.py falls back to BASE_DIR/db.sqlite3). To switch to the
# bundled `db` postgres service, follow the SQLite -> Postgres runbook
# in STATUS.md and then set:
#   DATABASE_URL=postgres://deepgis:deepgis@db:5432/deepgis
DATABASE_URL=
POSTGRES_DB=deepgis
POSTGRES_USER=deepgis
POSTGRES_PASSWORD=deepgis

# Gunicorn tuning. Defaults match Dockerfile CMD; raise WORKERS only if
# you've audited GPU memory headroom for analyzers that locally import
# torch (sam.py local fallback, etc.).
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=600

# Twilio Configuration (for phone number authentication)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Redis Configuration (for Celery training-task queue + result backend)
REDIS_URL=redis://redis:6379/0

# GIS Services Configuration
VECTOR_TILES_URL=https://vector_tiles:8080
RASTER_TILES_URL=https://raster_tiles:8081

# AI pilot chat on /label/3d/search/ (optional): read-only dreams_mcp on the
# DREAMS Lab GPU box. Use its DREAMS_MCP_RO_TOKEN, never the command-enabled one.
DEEPGIS_PILOT_MCP_URL=http://10.99.0.2:8766/mcp
DEEPGIS_PILOT_MCP_TOKEN=

# Live vehicle poses and camera frames (follow_vehicle). One "vehicle_id:sha256(token)" per publisher:
#   T=$(openssl rand -hex 24); printf %s "$T" | sha256sum   # give $T to the publisher only
VEHICLE_POSE_TOKENS=
# Sims started by the OpenUAV launcher: the same secret as its DEEPGIS_FLEET_SECRET
VEHICLE_FLEET_SECRET=
# VEHICLE_FLEET_PREFIX=openuav-
LIVE_CACHE_URL=redis://redis:6379/1

# Remote AI Services
#
# Unified maskrcnn endpoint (preferred). Set this if you've consolidated the
# per-family services behind a single container that takes a model_id form
# field. The per-family URLs below take precedence when set, so you can roll
# the unified service out one family at a time.
MASKRCNN_API_URL=
# Per-family backward-compat (legacy). Set the ones your deployment has live.
GROUNDING_DINO_API_URL=http://192.168.0.232:5000
GROUNDED_SAM_API_URL=http://192.168.0.232:5001
SAM_API_URL=http://192.168.0.232:5010
MASKRCNN_ROCKS_API_URL=http://192.168.0.232:5002
MASKRCNN_HOUSE_API_URL=http://192.168.0.232:5003
MASKRCNN_HYPOLITH_API_URL=http://192.168.0.232:5004
MASKRCNN_LITTER_API_URL=http://192.168.0.232:5005
MASKRCNN_ROADKILL_API_URL=http://192.168.0.232:5006
MASKRCNN_NEWLIFE_API_URL=http://192.168.0.232:5007
MASKRCNN_BRENT_MOON_CRATERS_API_URL=http://192.168.0.232:5008
MASKRCNN_HARISH_MOON_CRATERS_API_URL=http://192.168.0.232:5009

# Host GPU index reserved for the web container (docker-compose device_ids).
# Pick a GPU that is not driving a display or simulator: SAM's local fallback
# keeps its model resident in the gunicorn worker.
DEEPGIS_WEB_GPU=0
