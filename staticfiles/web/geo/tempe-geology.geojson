  {
   "type": "Feature",
   "properties": {
    "name": "Camelback Mountain",
    "category": "granite inselberg with sedimentary cap",
    "rock_units": "Camelback Granite ('hump'); Camels Head Formation ('head')",
    "age": "Granite ~1.4 Ga (Mesoproterozoic); cap ~25 Ma",
    "description": "Coarse Proterozoic granite with K-feldspar phenocrysts forms the hump. The nonconformity at Echo Canyon spans roughly 1.4 billion years of missing time.",
    "sources": [
     {
      "title": "USGS Geolex: Camelback Granite",
      "url": "https://ngmdb.usgs.gov/Geolex/search"
     },
     {
      "title": "Reynolds, Geology and subsurface of the Phoenix basin",
      "url": "https://reynolds.asu.edu/"
     }
    ],
