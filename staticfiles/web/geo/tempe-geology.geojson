  {
   "type": "Feature",
   "properties": {
    "name": "Hole-in-the-Rock",
    "category": "tafoni / weathering landform",
    "rock_units": "Arkosic conglomeratic sandstone and breccia (Camels Head Formation) on Camelback Granite",
    "age": "Rock mid-Tertiary; openings Quaternary weathering",
    "description": "Openings are tafoni enlarged by chemical weathering beneath calcium and iron coatings, not wind or salt. Nearby, the red beds rest nonconformably on Proterozoic granite.",
    "sources": [
     {
      "title": "AZGS Arizona Geology, Geology of the Papago Buttes (2013)",
      "url": "http://azgeology.azgs.arizona.edu/azgs/image-of-the-day/images/geology-papago-buttes-phoenix-az"
     },
     {
      "title": "Earth Surface Processes and Landforms 24(3):271 (1999), tafoni weathering",
      "url": "https://doi.org/10.1002/(SICI)1096-9837(199903)24:3<271::AID-ESP969>3.0.CO;2-T"
     },
     {
      "title": "Reynolds, Geology and subsurface of the Phoenix basin",
      "url": "https://reynolds.asu.edu/"
     }
    ],
    "osm_id": "w974216087",
    "coord_source": "OpenStreetMap Nominatim (data (c) OpenStreetMap contributors, ODbL)"
   },
