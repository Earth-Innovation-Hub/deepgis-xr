{
 "type": "FeatureCollection",
 "name": "Tempe-area geology (sourced)",
 "features": [
  {
   "type": "Feature",
   "properties": {
    "name": "Tempe Butte (Hayden Butte)",
    "category": "volcanic butte",
    "rock_units": "Andesite lava flows over the Tempe Beds (mudrock, sandstone) over rhyolitic ash",
    "age": "Andesite ~17.6 +/- 0.4 Ma (Miocene)",
    "description": "Miocene andesite flows cap sedimentary Tempe Beds that show soft-sediment deformation; the whole stack was later tilted to the south.",
    "sources": [
     {
      "title": "Pewe, Wellendorf & Bales 1986, Geology of the Tempe Quadrangle (AZ Bureau of Geology GI-2-A)",
      "url": "https://azgs.arizona.edu/"
     },
     {
      "title": "Paradise Valley CC virtual field trip: Tempe Butte",
      "url": "https://www2.paradisevalley.edu/~douglass/v_trips/t_butte/"
     }
    ],
    "osm_id": "n359252381",
    "coord_source": "OpenStreetMap Nominatim (data (c) OpenStreetMap contributors, ODbL)"
   },
   "geometry": {
    "type": "Point",
    "coordinates": [
     -111.93582,
     33.42827
    ]
   }
  },
  {
   "type": "Feature",
   "properties": {
    "name": "Papago Buttes",
    "category": "tilted sedimentary buttes",
    "rock_units": "Camels Head Formation: sedimentary breccia, conglomerate, sandstone, siltstone",
    "age": "Mid-Tertiary (Oligocene-Miocene)",
    "description": "Red beds of the Camels Head Formation dip steeply south-west. They were deposited and tilted in half-grabens during the extension that formed the South Mountains core complex.",
    "sources": [
     {
      "title": "AZGS Arizona Geology, Geology of the Papago Buttes (2013)",
      "url": "http://azgeology.azgs.arizona.edu/azgs/image-of-the-day/images/geology-papago-buttes-phoenix-az"
     },
     {
      "title": "AZGS GI-2-C, Tempe quadrangle cross sections",
      "url": "https://data.azgs.arizona.edu/api/v1/collections/PEGC-1552427551346-578/tempegi-2-c.pdf"
     }
    ],
    "osm_id": "n359249703",
    "coord_source": "OpenStreetMap Nominatim (data (c) OpenStreetMap contributors, ODbL)"
   },
   "geometry": {
    "type": "Point",
    "coordinates": [
     -111.95153,
     33.46418
    ]
   }
  },
  {
   "type": "Feature",
   "properties": {
    "name": "Barnes Butte",
    "category": "tilted sedimentary butte",
    "rock_units": "Camels Head Formation",
    "age": "Mid-Tertiary",
    "description": "At 1,746 ft, the highest point in the Tempe 7.5' quadrangle; part of the Papago Buttes.",
    "sources": [
     {
      "title": "Pewe, Wellendorf & Bales 1986, Geology of the Tempe Quadrangle (AZ Bureau of Geology GI-2-A)",
